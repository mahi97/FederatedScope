# ── Storage root ── all heavy files live under this path ──
STORAGE_ROOT=/drive1/mahi

# ── HuggingFace cache ──
HF_HOME=/drive1/mahi/huggingface
HUGGINGFACE_HUB_CACHE=/drive1/mahi/huggingface/hub
TRANSFORMERS_CACHE=/drive1/mahi/huggingface/hub
HF_DATASETS_CACHE=/drive1/mahi/data

# ── Online mode (allow downloads) ──
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_DATASETS_OFFLINE=0

# ── Experiment outputs & results ──
APRILS_OUTPUT_DIR=/drive1/mahi/output
APRILS_EXP_DIR=/drive1/mahi/experiments

# ── WandB ──
WANDB_DIR=/drive1/mahi/wandb
WANDB_CACHE_DIR=/drive1/mahi/wandb/.cache

# ── Prevent writes to ~/.cache or project dir ──
XDG_CACHE_HOME=/drive1/mahi/.cache
TORCH_HOME=/drive1/mahi/torch